<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:soundEffectsEnabled">false</item>
        <item name="android:colorAccent">#6DDCC5</item>
        <item name="android:textColorPrimary">@color/readable_text</item>
        <item name="android:textColorSecondary">@color/readable_secondary_text</item>
        <item name="android:textColorHint">@color/readable_secondary_text</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:windowBackground">#0D1620</item>
        <item name="android:navigationBarColor">#0D1620</item>
        <item name="android:statusBarColor">#0D1620</item>
        <item name="android:alertDialogTheme">@style/GameDialog</item>
    </style>
    <style name="GameDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:soundEffectsEnabled">false</item>
        <item name="android:colorAccent">#81E2C4</item>
        <item name="android:textColorPrimary">@color/readable_text</item>
        <item name="android:textColorSecondary">@color/readable_secondary_text</item>
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:backgroundDimAmount">0.42</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
</resources>
