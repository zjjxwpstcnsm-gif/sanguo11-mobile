      "decoded": {
        "native_id": 11,
        "date": [
          187,
          4,
          1
        ],
        "name": "何進包圍網",
        "description": "平定黃巾之亂之何進手握絕大權力，繼而終以皇帝自稱。其蔑視朝廷權威之舉激怒眾諸侯，故於各自之故里家鄉興兵反亂。時代演變為群雄割據之局面。趁局勢混亂之便黃巾之殘黨捲土重來。新皇帝治世揭開亂世舞台之簾幕。",
        "name_bytes": "a6f3b669a55db3f2baf4",
        "description_bytes": ""
      }
    },
    {
      "path": "Media/scenario/Scen012.s11",
