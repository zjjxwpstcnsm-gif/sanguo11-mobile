      "decoded": {
        "native_id": 12,
        "date": [
          191,
          7,
          1
        ],
        "name": "局勢掌控者",
        "description": "為討伐佔朝廷為己物之董卓而發動群起之諸侯連合，於尚未達成目標前即告解散。諸侯中分別為聲名顯赫之袁紹、袁術、公孫瓚三派，開始互相進行爭鬥。企圖捲土重來之董卓。未加入諸侯連合之英雄豪傑。時代為群雄割據之舞台更添戲劇色彩。",
        "name_bytes": "a7bdb6d5b478b1b1aacc",
        "description_bytes": ""
      }
    },
