// Camera overview specialization: original albedo/shore/season and geometry retained.
// No new texture uploads; near PBR source and binary are deliberately unchanged.
material {
    name : NationalGroundV110,
    flipUV : false,
    shadingModel : unlit,
    doubleSided : true,
    requires : [ color, uv0, uv1 ],
    parameters : [
        { type : float3, name : artTint },
        { type : float3, name : plantTint },
        { type : sampler2d, name : grassColor },
        { type : sampler2d, name : soilColor },
        { type : sampler2d, name : sandColor },
        { type : sampler2d, name : rockColor }

    ]
}
fragment {
    void material(inout MaterialInputs material) {
        // UV remains absolute world X/-Z, including chunks and outer scenery.
        float2 worldUV = getUV0();
        float2 uv = worldUV * 0.35;
        float2 uvB = float2(uv.x*0.8-uv.y*0.6,uv.x*0.6+uv.y*0.8)*0.731+float2(0.317,0.619);
        float4 w = max(getColor(), float4(0.0));
        float total = dot(w,float4(1.0));
        w = total > 0.00001 ? w/total : float4(0.0,1.0,0.0,0.0);
        float3 color = texture(materialParams_grassColor,uv).rgb*w.x
            + texture(materialParams_soilColor,uv).rgb*w.y
            + texture(materialParams_sandColor,uv).rgb*w.z
            + texture(materialParams_rockColor,uv).rgb*w.w;
        // Second incommensurate scale breaks tiling with no new textures/samplers.
        // Same albedo in LOW; quality only removes normal reads.
        float3 broad = texture(materialParams_grassColor,uvB).rgb*w.x
            + texture(materialParams_soilColor,uvB).rgb*w.y
            + texture(materialParams_sandColor,uvB).rgb*w.z
            + texture(materialParams_rockColor,uvB).rgb*w.w;
        color = mix(color,broad,0.38);
        color *= mix(float3(1.0),materialParams.plantTint,w.x);
        float macro = 0.97 + 0.025*sin(worldUV.x*0.113+sin(worldUV.y*0.071))
            + 0.015*cos(worldUV.y*0.139-worldUV.x*0.047);
        float wet = 1.0-smoothstep(0.0,0.38,abs(getUV1().x));
        prepareMaterial(material);
        material.baseColor = float4(color*materialParams.artTint*macro*getUV1().y*mix(1.0,0.64,wet),1.0);
        float haze=smoothstep(320.0,410.0,length(getWorldPosition()-getWorldCameraPosition()))*0.08;
        material.baseColor.rgb=mix(material.baseColor.rgb,float3(0.22,0.25,0.24),haze);
    }
}
