material {
    name : StrategicLandscapeCascades,
    shadingModel : lit,
    doubleSided : true,
    requires : [ color, uv0 ],
    parameters : [
        { type : float3, name : artTint },
        { type : float3, name : plantTint }, { type : sampler2d, name : atlas }, { type : float, name : damage }, { type : float, name : flowTime } ]
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        float2 uv=getUV0();
        float cascade=step(0.625,uv.x)*(1.0-step(0.75,uv.x));
        // Slot 5 exists only in the dedicated landscape atlas. Keep the other
        // panels/LOD borders fixed; bounded scrolling gives downhill foam flow.
        uv.y=mix(uv.y,0.06+fract((uv.y-0.06)/0.88+materialParams.flowTime*0.28)*0.88,cascade);
        float3 base = texture(materialParams_atlas, uv).rgb * getColor().rgb;
        float leaf=(1.0-cascade)*smoothstep(0.0,0.055,base.g-max(base.r,base.b));
        base*=materialParams.artTint*mix(float3(1.0),materialParams.plantTint,leaf);
        material.roughness = 0.88;
        material.metallic = 0.0;
        material.reflectance = 0.25;
        material.baseColor = float4(base * (1.0 - materialParams.damage * 0.32), 1.0);
        float haze=smoothstep(320.0,410.0,length(getWorldPosition()-getWorldCameraPosition()))*0.08;
        material.baseColor.rgb=mix(material.baseColor.rgb,float3(0.22,0.25,0.24),haze);
    }
}
